{{!
    @template report_courseradar/student_view

    Personal activity dashboard shown to enrolled students.

    Context variables required for this template:
    * coursename string Course full name.
    * haskpis bool Whether any KPI card is enabled.
    * showscore / showcoverage / showcompletion / showdedication / showdaysinactive bool KPI flags.
    * showcomparison bool Whether the class comparison card is shown.
    * showcmpscore / showcmpcoverage / showcmpcompletion / showcmpdedication bool Comparison rows.
    * showpending / showchart bool Lower cards.
    * pendingcolclass / chartcolclass string Bootstrap column classes.
    * score int Engagement score 0-100.
    * scoreclass string Bootstrap bg- class for the score.
    * coverage int Percentage of resources visited.
    * coverageclass string Bootstrap bg- class for the coverage.
    * completion int Percentage of tracked activities completed.
    * hascompletion bool Whether the completion KPI is shown.
    * daysinactive string Days since last access (or "never" text).
    * hasdedication bool Whether the time-spent KPI is shown.
    * dedication string My formatted time spent in the course.
    * dedicationpct int Width of my time-spent bar, relative to the larger value.
    * classdedication string Class average formatted time spent.
    * classdedicationpct int Width of the class average time-spent bar.
    * dedicationabove bool Whether my time spent is at or above the class average.
    * classscore int Class average engagement score.
    * classcoverage int Class average coverage.
    * classcompletion int Class average completion.
    * scoreabove bool Whether my score is at or above the class average.
    * coverageabove bool Whether my coverage is at or above the class average.
    * completionabove bool Whether my completion is at or above the class average.
    * pending array List of {name, url, icon, type} pending resources.
    * haspending bool Whether there are pending resources.
    * pendingcount int Number of pending resources.
    * allvisited bool Whether every available resource was opened.
    * charthtml string Rendered activity chart HTML.
    * haschart bool Whether there is a chart to show.

    Example context (json):
    {
        "coursename": "Maths 101",
        "score": 72, "scoreclass": "bg-success",
        "coverage": 64, "coverageclass": "bg-warning",
        "completion": 50, "hascompletion": true,
        "daysinactive": 2,
        "hasdedication": true, "dedication": "4h 20m", "dedicationpct": 100,
        "classdedication": "3h 10m", "classdedicationpct": 73, "dedicationabove": true,
        "classscore": 58, "classcoverage": 55, "classcompletion": 41,
        "scoreabove": true, "coverageabove": true, "completionabove": true,
        "pending": [{"name": "Topic 3 quiz", "url": "#", "icon": "", "type": "Quiz"}],
        "haspending": true, "pendingcount": 1, "allvisited": false,
        "charthtml": "", "haschart": false
    }
}}
<div class="cr-student">

  <p class="text-muted mb-4">{{#str}}studentintro, report_courseradar{{/str}}</p>

  {{! KPI cards }}
  {{#haskpis}}
  <div class="row g-3 mb-4">
    {{#showscore}}
    <div class="col-6 col-lg-3">
      <div class="card cr-card h-100 text-center">
        <div class="card-body">
          <div class="cr-stat {{scoretextclass}}">{{score}}</div>
          <div class="cr-stat-label">{{#str}}riskscore, report_courseradar{{/str}}</div>
          <div class="small text-muted">{{#str}}riskscore_desc, report_courseradar{{/str}}</div>
        </div>
      </div>
    </div>
    {{/showscore}}
    {{#showcoverage}}
    <div class="col-6 col-lg-3">
      <div class="card cr-card h-100 text-center">
        <div class="card-body">
          <div class="cr-stat">{{coverage}}%</div>
          <div class="cr-stat-label">{{#str}}resourcesvisited, report_courseradar{{/str}}</div>
          <div class="small text-muted">{{#str}}studentcoverage_desc, report_courseradar{{/str}}</div>
        </div>
      </div>
    </div>
    {{/showcoverage}}
    {{#showcompletion}}
    <div class="col-6 col-lg-3">
      <div class="card cr-card h-100 text-center">
        <div class="card-body">
          <div class="cr-stat">{{completion}}%</div>
          <div class="cr-stat-label">{{#str}}completionstu, report_courseradar{{/str}}</div>
          <div class="small text-muted">{{#str}}completionstu_desc, report_courseradar{{/str}}</div>
        </div>
      </div>
    </div>
    {{/showcompletion}}
    {{#showdedication}}
    <div class="col-6 col-lg-3">
      <div class="card cr-card h-100 text-center">
        <div class="card-body">
          <div class="cr-stat">{{dedication}}</div>
          <div class="cr-stat-label">{{#str}}dedication, report_courseradar{{/str}}</div>
          <div class="small text-muted">{{#str}}dedication_desc, report_courseradar{{/str}}</div>
        </div>
      </div>
    </div>
    {{/showdedication}}
    {{#showdaysinactive}}
    <div class="col-6 col-lg-3">
      <div class="card cr-card h-100 text-center">
        <div class="card-body">
          <div class="cr-stat">{{daysinactive}}</div>
          <div class="cr-stat-label">{{#str}}daysinactive, report_courseradar{{/str}}</div>
          <div class="small text-muted">{{#str}}daysinactive_desc, report_courseradar{{/str}}</div>
        </div>
      </div>
    </div>
    {{/showdaysinactive}}
    {{#showconexiones}}
    <div class="col-6 col-lg-3">
      <div class="card cr-card h-100 text-center">
        <div class="card-body">
          <div class="cr-stat" id="cr-stu-live">{{#conexstale}}<span class="spinner-border spinner-border-sm text-muted" role="status"></span>{{/conexstale}}{{^conexstale}}{{conexioneslive}}{{/conexstale}}</div>
          <div class="cr-stat-label">{{#str}}conexioneslive, report_courseradar{{/str}}</div>
          <div class="small text-muted">{{#str}}conexioneslive_desc, report_courseradar{{/str}}</div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card cr-card h-100 text-center">
        <div class="card-body">
          <div class="cr-stat" id="cr-stu-delayed">{{#conexstale}}<span class="spinner-border spinner-border-sm text-muted" role="status"></span>{{/conexstale}}{{^conexstale}}{{conexionesdelayed}}{{/conexstale}}</div>
          <div class="cr-stat-label">{{#str}}conexionesdelayed, report_courseradar{{/str}}</div>
          <div class="small text-muted">{{#str}}conexionesdelayed_desc, report_courseradar{{/str}}</div>
        </div>
      </div>
    </div>
    <div class="col-12">
      <p class="small text-muted mb-0">{{#str}}conexionespercentof, report_courseradar{{/str}}</p>
    </div>
    {{/showconexiones}}
  </div>
  {{#showconexiones}}
    <p class="small text-muted mb-2">{{#str}}conexionesviewdelay, report_courseradar{{/str}}</p>
    <div class="card cr-card mb-4" id="cr-sessions">
      <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <h5 class="mb-0 fw-bold">{{#str}}visionadosessions, report_courseradar{{/str}}</h5>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="cr-sessions-detail"
                  aria-expanded="false" aria-controls="cr-sessions-panel">
            {{#str}}details, report_courseradar{{/str}}
          </button>
        </div>
        <div id="cr-sessions-panel" class="d-none mt-3">
          <p class="small text-muted mb-2">{{#str}}visionadotimes, report_courseradar{{/str}}</p>
          <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mb-2">
            <div class="cr-session-legend small">
              <span><i class="cr-swatch cr-swatch-live" aria-hidden="true"></i> {{#str}}visionadolive, report_courseradar{{/str}}</span>
              <span><i class="cr-swatch cr-swatch-rec" aria-hidden="true"></i> {{#str}}visionadorecording, report_courseradar{{/str}}</span>
            </div>
          </div>
          <div id="cr-sessions-body"></div>
        </div>
      </div>
    </div>
  {{/showconexiones}}
  {{/haskpis}}

  {{! Comparison with the class average }}
  {{#showcomparison}}
  <div class="card cr-card mb-4">
    <div class="card-header bg-white border-bottom py-3">
      <h5 class="mb-0 fw-bold">{{#str}}compareclass, report_courseradar{{/str}}</h5>
      <small class="text-muted">{{#str}}compareclass_desc, report_courseradar{{/str}}</small>
    </div>
    <div class="card-body">
      {{#showcmpscore}}
      <div class="mb-3">
        <div class="d-flex justify-content-between mb-1">
          <span class="fw-semibold">{{#str}}riskscore, report_courseradar{{/str}}</span>
          <span>
            <span id="cr-badge-score" class="badge bg-secondary text-white d-none" data-you="{{score}}"></span>
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div class="progress-bar {{scoreclass}}" role="progressbar" style="width: {{score}}%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}you, report_courseradar{{/str}}: {{score}}</span>
        </div>
        <div class="d-flex align-items-center gap-2 mt-1">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div id="cr-cls-score-bar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}classaverage, report_courseradar{{/str}}: <span id="cr-cls-score"><span class="spinner-border spinner-border-sm text-muted" role="status"></span></span></span>
        </div>
      </div>
      {{/showcmpscore}}

      {{#showcmpcoverage}}
      <div class="mb-3">
        <div class="d-flex justify-content-between mb-1">
          <span class="fw-semibold">{{#str}}resourcesvisited, report_courseradar{{/str}}</span>
          <span>
            <span id="cr-badge-coverage" class="badge bg-secondary text-white d-none" data-you="{{coverage}}"></span>
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div class="progress-bar {{coverageclass}}" role="progressbar" style="width: {{coverage}}%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}you, report_courseradar{{/str}}: {{coverage}}%</span>
        </div>
        <div class="d-flex align-items-center gap-2 mt-1">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div id="cr-cls-coverage-bar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}classaverage, report_courseradar{{/str}}: <span id="cr-cls-coverage"><span class="spinner-border spinner-border-sm text-muted" role="status"></span></span>%</span>
        </div>
      </div>
      {{/showcmpcoverage}}

      {{#showcmpcompletion}}
      <div>
        <div class="d-flex justify-content-between mb-1">
          <span class="fw-semibold">{{#str}}completionstu, report_courseradar{{/str}}</span>
          <span>
            <span id="cr-badge-completion" class="badge bg-secondary text-white d-none" data-you="{{completion}}"></span>
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div class="progress-bar bg-info" role="progressbar" style="width: {{completion}}%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}you, report_courseradar{{/str}}: {{completion}}%</span>
        </div>
        <div class="d-flex align-items-center gap-2 mt-1">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div id="cr-cls-completion-bar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}classaverage, report_courseradar{{/str}}: <span id="cr-cls-completion"><span class="spinner-border spinner-border-sm text-muted" role="status"></span></span>%</span>
        </div>
      </div>
      {{/showcmpcompletion}}

      {{#showcmpdedication}}
      <div class="mt-3">
        <div class="d-flex justify-content-between mb-1">
          <span class="fw-semibold">{{#str}}dedication, report_courseradar{{/str}}</span>
          <span>
            <span id="cr-badge-dedication" class="badge bg-secondary text-white d-none"></span>
          </span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div class="progress-bar bg-dark" role="progressbar" style="width: {{dedicationpct}}%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}you, report_courseradar{{/str}}: {{dedication}}</span>
        </div>
        <div class="d-flex align-items-center gap-2 mt-1">
          <div class="progress cr-cmp-progress flex-grow-1">
            <div id="cr-cls-dedication-bar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%;"></div>
          </div>
          <span class="cr-cmp-caption">{{#str}}classaverage, report_courseradar{{/str}}: <span id="cr-cls-dedication"><span class="spinner-border spinner-border-sm text-muted" role="status"></span></span></span>
        </div>
      </div>
      {{/showcmpdedication}}
    </div>
  </div>
  {{/showcomparison}}

  <div class="row g-3">
    {{! Pending resources }}
    {{#showpending}}
    <div class="{{pendingcolclass}}">
      <div class="card cr-card h-100">
        <div class="card-header bg-white border-bottom py-3">
          <h5 class="mb-0 fw-bold">
            {{#str}}pendingresources, report_courseradar{{/str}}
            {{#haspending}}<span class="badge bg-danger text-white ms-1">{{pendingcount}}</span>{{/haspending}}
          </h5>
          <small class="text-muted">{{#str}}pendingresources_desc, report_courseradar{{/str}}</small>
        </div>
        <div class="card-body">
          {{#allvisited}}
            <div class="text-success fw-semibold">
              <i class="fa fa-check-circle me-1"></i>{{#str}}allvisited, report_courseradar{{/str}}
            </div>
          {{/allvisited}}
          {{#haspending}}
          <ul class="list-group list-group-flush">
            {{#pending}}
            <li class="list-group-item d-flex align-items-center px-0">
              <img src="{{icon}}" alt="" class="cr-mod-icon me-2">
              <a href="{{url}}" class="text-truncate">{{name}}</a>
              <span class="badge bg-light text-muted ms-auto">{{type}}</span>
            </li>
            {{/pending}}
          </ul>
          {{/haspending}}
        </div>
      </div>
    </div>
    {{/showpending}}

    {{! Activity over time }}
    {{#showchart}}
    <div class="{{chartcolclass}}">
      <div class="card cr-card h-100">
        <div class="card-header bg-white border-bottom py-3">
          <h5 class="mb-0 fw-bold">{{#str}}activityovertime, report_courseradar{{/str}}</h5>
          <small class="text-muted">{{#str}}myactivity_desc, report_courseradar{{/str}}</small>
        </div>
        <div class="card-body">
          <div id="cr-stu-chart-loading" class="text-muted small">
            <span class="spinner-border spinner-border-sm text-muted" role="status"></span>
            {{#str}}loadingdata, report_courseradar{{/str}}
          </div>
          <canvas id="cr-stu-chart" class="d-none" height="120"></canvas>
          <p id="cr-stu-chart-empty" class="text-muted mb-0 d-none">{{#str}}noactivitydata, report_courseradar{{/str}}</p>
        </div>
      </div>
    </div>
    {{/showchart}}
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var extras = '{{wwwroot}}/report/courseradar/student_extras.php'
        + '?id={{courseid}}&sesskey={{sesskey}}';
    fetch(extras, {credentials: 'same-origin'})
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var setBar = function(barId, txtId, pct, label) {
                var bar = document.getElementById(barId);
                var txt = document.getElementById(txtId);
                if (bar) { bar.style.width = (pct || 0) + '%'; }
                if (txt) { txt.textContent = label; }
            };
            setBar('cr-cls-score-bar', 'cr-cls-score', data.classscore, data.classscore);
            setBar('cr-cls-coverage-bar', 'cr-cls-coverage', data.classcoverage, data.classcoverage);
            setBar('cr-cls-completion-bar', 'cr-cls-completion', data.classcompletion, data.classcompletion);
            setBar('cr-cls-dedication-bar', 'cr-cls-dedication', data.classdedicationpct, data.classdedication);
            var aboveStr = '{{#str}}aboveaverage, report_courseradar{{/str}}';
            var belowStr = '{{#str}}belowaverage, report_courseradar{{/str}}';
            var setBadge = function(id, you, avg) {
                var el = document.getElementById(id);
                if (!el) {
                    return;
                }
                var above = Number(you) >= Number(avg);
                el.textContent = above ? aboveStr : belowStr;
                el.classList.remove('d-none', 'bg-success', 'bg-secondary');
                el.classList.add(above ? 'bg-success' : 'bg-secondary');
            };
            var scoreBadge = document.getElementById('cr-badge-score');
            var covBadge = document.getElementById('cr-badge-coverage');
            var compBadge = document.getElementById('cr-badge-completion');
            setBadge('cr-badge-score', scoreBadge ? scoreBadge.getAttribute('data-you') : 0, data.classscore);
            setBadge('cr-badge-coverage', covBadge ? covBadge.getAttribute('data-you') : 0, data.classcoverage);
            setBadge('cr-badge-completion', compBadge ? compBadge.getAttribute('data-you') : 0, data.classcompletion);
            if (typeof data.dedicationpct === 'number') {
                setBadge('cr-badge-dedication', data.dedicationpct, data.classdedicationpct);
            }
            var youded = document.querySelector('#cr-cls-dedication-bar')
                && document.querySelector('.progress-bar.bg-dark');
            if (youded && typeof data.dedicationpct === 'number') {
                youded.style.width = data.dedicationpct + '%';
            }
            var loading = document.getElementById('cr-stu-chart-loading');
            var canvas = document.getElementById('cr-stu-chart');
            var empty = document.getElementById('cr-stu-chart-empty');
            if (data.chartdata && data.chartdata.values && data.chartdata.values.length && canvas) {
                if (loading) { loading.classList.add('d-none'); }
                canvas.classList.remove('d-none');
                if (typeof require === 'function') {
                    require(['core/chartjs'], function(Chartjs) {
                        new Chartjs(canvas, {
                            type: 'line',
                            data: {
                                labels: data.chartdata.labels,
                                datasets: [{
                                    data: data.chartdata.values,
                                    borderColor: '#0d6efd',
                                    fill: false,
                                    tension: 0.35,
                                    pointRadius: 2
                                }]
                            },
                            options: {
                                responsive: true,
                                plugins: { legend: { display: false } },
                                scales: { y: { beginAtZero: true } }
                            }
                        });
                    });
                }
            } else if (empty) {
                if (loading) { loading.classList.add('d-none'); }
                empty.classList.remove('d-none');
            }
        })
        .catch(function() { /* KPIs already shown. */ });

    {{#showconexiones}}
    var paintConexStat = function(el) {
        if (!el || el.querySelector('.cr-stat-time')) {
            return;
        }
        var text = (el.textContent || '').trim();
        var match = text.match(/^(.*)\s·\s(\d+(?:[.,]\d+)?%)$/);
        if (!match) {
            return;
        }
        el.innerHTML = '<span class="cr-stat-time">' + escSession(match[1].trim()) + '</span>'
            + '<span class="cr-stat-pct">' + escSession(match[2]) + '</span>';
    };
    {{/showconexiones}}

    {{#conexstale}}
    var url = '{{wwwroot}}/report/courseradar/conexiones.php'
        + '?id={{courseid}}&userid={{myid}}&refresh=1&sesskey={{sesskey}}';
    fetch(url, {credentials: 'same-origin'})
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var live = document.getElementById('cr-stu-live');
            var delayed = document.getElementById('cr-stu-delayed');
            if (live && data.live && data.live.label) {
                live.textContent = data.live.label;
                if (typeof paintConexStat === 'function') {
                    paintConexStat(live);
                }
            }
            if (delayed && data.delayed && data.delayed.label) {
                delayed.textContent = data.delayed.label;
                if (typeof paintConexStat === 'function') {
                    paintConexStat(delayed);
                }
            }
        })
        .catch(function() { /* Keep cached placeholders. */ });
    {{/conexstale}}

    {{#showconexiones}}
    var sessionBody = document.getElementById('cr-sessions-body');
    var sessionBtn = document.getElementById('cr-sessions-detail');
    var sessionPanel = document.getElementById('cr-sessions-panel');
    var visionadoEmpty = {{#quote}}{{#str}}conexionesnodetail, report_courseradar{{/str}}{{/quote}};
    var visionadoError = {{#quote}}{{#str}}conexioneserror, report_courseradar{{/str}}{{/quote}};
    var visionadoLoading = {{#quote}}{{#str}}visionadoloading, report_courseradar{{/str}}{{/quote}};
    var visionadoSchedule = {{#quote}}{{#str}}visionadoschedule, report_courseradar{{/str}}{{/quote}};
    var visionadoTotal = {{#quote}}{{#str}}visionadototal, report_courseradar{{/str}}{{/quote}};
    var visionadoLive = {{#quote}}{{#str}}visionadolive, report_courseradar{{/str}}{{/quote}};
    var visionadoRec = {{#quote}}{{#str}}visionadorecording, report_courseradar{{/str}}{{/quote}};
    var visionadoUrl = '{{wwwroot}}/report/courseradar/conexiones.php'
        + '?id={{courseid}}&userid={{myid}}&visionado=1&sesskey={{sesskey}}';
    var escSession = function(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function(ch) {
            return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[ch];
        });
    };
    var columnHeight = function(seconds, scale) {
        if (!(scale > 0) || !(seconds > 0)) {
            return 0;
        }
        return Math.max(1, Math.min(100, Math.round(100 * seconds / scale)));
    };
    var sessionBar = function(fillClass, height) {
        var col = height > 0
            ? '<div class="cr-session-col ' + fillClass + '" style="height:' + height + '%"></div>'
            : '';
        return '<div class="cr-session-colwell">' + col + '</div>';
    };
    var sessionLabel = function(nameClass, name, label) {
        return '<span class="cr-session-time" title="' + escSession(name) + ': ' + label + '">'
            + '<span class="cr-session-name ' + nameClass + '">' + escSession(name) + '</span>'
            + '<span class="cr-session-dur">' + label + '</span></span>';
    };
    var renderSessions = function(data) {
        var rows = (data && Array.isArray(data.rows)) ? data.rows : [];
        if (!data || data.ok === false) {
            return '<p class="small text-danger mb-0">' + escSession(visionadoError) + '</p>';
        }
        if (!rows.length) {
            return '<p class="small text-muted mb-0">' + escSession(visionadoEmpty) + '</p>';
        }
        var fallback = 0;
        rows.forEach(function(row) {
            fallback = Math.max(fallback, Number(row.live) || 0, Number(row.delayed) || 0);
        });
        var html = '';
        rows.forEach(function(row) {
            var span = row.start ? escSession(row.start) : '';
            var liveLabel = escSession(row.livelabel || '—');
            var delayedLabel = escSession(row.delayedlabel || '—');
            html += '<div class="cr-session"><div class="cr-session-when"><div class="fw-semibold">'
                + escSession(row.when || '') + '</div>';
            if (span) {
                html += '<div class="text-muted cr-session-clock"><span class="cr-session-kind">'
                    + escSession(visionadoSchedule) + '</span> ' + span + '</div>';
            }
            if (row.classlabel) {
                html += '<div class="text-muted cr-session-clock"><span class="cr-session-kind">'
                    + escSession(visionadoTotal) + '</span> ' + escSession(row.classlabel) + '</div>';
            }
            html += '</div><div class="cr-session-cols">';
            html += '<div class="cr-session-bars" aria-hidden="true">';
            html += sessionBar(
                'cr-session-live',
                columnHeight(Number(row.live) || 0, fallback)
            );
            html += sessionBar(
                'cr-session-rec',
                columnHeight(Number(row.delayed) || 0, fallback)
            );
            html += '</div><div class="cr-session-labels">';
            html += sessionLabel('cr-session-live-name', visionadoLive, liveLabel);
            html += sessionLabel('cr-session-rec-name', visionadoRec, delayedLabel);
            html += '</div></div></div>';
        });
        return html;
    };
    var sessionLoaded = false;
    var sessionLoading = false;
    var loadSessions = function() {
        if (!sessionBody || sessionLoading || sessionLoaded) {
            return;
        }
        sessionLoading = true;
        sessionBody.innerHTML = '<p class="small text-muted mb-0"><span class="spinner-border spinner-border-sm" role="status"></span> '
            + escSession(visionadoLoading) + '</p>';
        fetch(visionadoUrl, {credentials: 'same-origin'})
            .then(function(r) { return r.json(); })
            .then(function(data) {
                sessionLoaded = true;
                sessionLoading = false;
                sessionBody.innerHTML = renderSessions(data);
            })
            .catch(function() {
                sessionLoading = false;
                sessionBody.innerHTML = '<p class="small text-danger mb-0">' + escSession(visionadoError) + '</p>';
            });
    };
    paintConexStat(document.getElementById('cr-stu-live'));
    paintConexStat(document.getElementById('cr-stu-delayed'));
    if (sessionBtn && sessionPanel) {
        sessionBtn.addEventListener('click', function() {
            var open = sessionBtn.getAttribute('aria-expanded') === 'true';
            if (open) {
                sessionPanel.classList.add('d-none');
                sessionBtn.setAttribute('aria-expanded', 'false');
                return;
            }
            sessionPanel.classList.remove('d-none');
            sessionBtn.setAttribute('aria-expanded', 'true');
            loadSessions();
        });
    }
    {{/showconexiones}}
});
</script>

